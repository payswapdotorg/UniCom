{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      // 2026-10-05: 扩展到 test 树下的支持文件（**/test/**）—— fuzz 词汇表等
      // test-support 枚举与测试同性质（W1-003 交付 fuzz.ts 463 有效行触发误报）。
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**/*.ts",
        "**/test/**/*.tsx"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "docs/electron"
  ]
}
